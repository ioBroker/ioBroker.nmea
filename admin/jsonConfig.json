{
    "type": "tabs",
    "i18n": true,
    "items": {
        "general": {
            "type": "panel",
            "label": "General",
            "items": {
                "type": {
                    "type": "select",
                    "label": "Hardware type",
                    "noTranslation": true,
                    "options": [
                        {
                            "label": "NGT-1",
                            "value": "ngt1"
                        },
                        {
                            "label": "PiCAN-M",
                            "value": "picanm"
                        },
                        {
                            "label": "Yacht Devices",
                            "value": "ydwg"
                        }
                    ],
                    "sm": 12,
                    "md": 6,
                    "lg": 4
                },
                "serialPort": {
                    "label": "Serial port",
                    "newLine": true,
                    "type": "selectSendTo",
                    "command": "list",
                    "manual": true,
                    "noTranslation": true,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "hidden": "data.type !== 'ngt1'"
                },
                "canPort": {
                    "label": "CAN port",
                    "newLine": true,
                    "type": "selectSendTo",
                    "command": "listCan",
                    "manual": true,
                    "noTranslation": true,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "hidden": "data.type !== 'picanm'"
                },
                "ydwgProtocol": {
                    "label": "Yacht Devices protocol",
                    "type": "select",
                    "options": [
                        {
                            "value": "tcp",
                            "label": "TCP"
                        },
                        {
                            "value": "udp",
                            "label": "UDP"
                        }
                    ],
                    "sm": 12,
                    "md": 2,
                    "lg": 1,
                    "default": "tcp",
                    "hidden": "data.type !== 'ydwg'"
                },
                "ydwgIp": {
                    "label": "IP",
                    "newLine": true,
                    "type": "text",
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "hidden": "data.type !== 'ydwg' || data.ydwgProtocol !== 'tcp'"
                },
                "ydwgPort": {
                    "label": "Port",
                    "type": "number",
                    "min": 1,
                    "max": 65535,
                    "sm": 12,
                    "md": 2,
                    "lg": 1,
                    "hidden": "data.type !== 'ydwg'",
                    "default": 1457
                },
                "updateAtLeastEveryMs": {
                    "newLine": true,
                    "label": "Update states at least every",
                    "help": "ms",
                    "type": "select",
                    "options": [
                        {
                            "label": "always update (not recommended)",
                            "value": 0
                        },
                        {
                            "label": "0,5 seconds",
                            "value": 500
                        },
                        {
                            "label": "1 second",
                            "value": 1000
                        },
                        {
                            "label": "2 seconds",
                            "value": 2000
                        },
                        {
                            "label": "5 seconds",
                            "value": 5000
                        },
                        {
                            "label": "10 seconds",
                            "value": 10000
                        },
                        {
                            "label": "15 seconds",
                            "value": 15000
                        },
                        {
                            "label": "30 seconds",
                            "value": 30000
                        },
                        {
                            "label": "1 minute",
                            "value": 60000
                        },
                        {
                            "label": "2 minutes",
                            "value": 120000
                        },
                        {
                            "label": "5 minutes",
                            "value": 120000
                        },
                        {
                            "label": "10 minutes",
                            "value": 600000
                        },
                        {
                            "label": "15 minutes",
                            "value": 900000
                        },
                        {
                            "label": "30 minutes",
                            "value": 1800000
                        },
                        {
                            "label": "1 hour",
                            "value": 3600000
                        },
                        {
                            "label": "2 hours",
                            "value": 7200000
                        },
                        {
                            "label": "5 hours",
                            "value": 18000000
                        },
                        {
                            "label": "10 hours",
                            "value": 36000000
                        },
                        {
                            "label": "24 hours",
                            "value": 86400000
                        }
                    ],
                    "sm": 12,
                    "md": 6,
                    "lg": 4
                },
                "approximateMs": {
                    "label": "Approximation time",
                    "help": "ms. Only for average and max values",
                    "type": "number",
                    "default": 10000,
                    "sm": 12,
                    "md": 6,
                    "lg": 4
                },
                "applyGpsTimeZoneToSystem": {
                    "label": "Use GPS time zone for system",
                    "type": "checkbox",
                    "sm": 12,
                    "md": 6,
                    "lg": 4
                },
                "deleteAisAfter": {
                    "label": "Delete AIS data if older than",
                    "help": "seconds",
                    "type": "number",
                    "min": 60,
                    "max": 604800,
                    "sm": 12,
                    "md": 6,
                    "lg": 4
                },
                "pressureAlertDiff": {
                    "newLine": true,
                    "label": "If pressure changes more than",
                    "help": "mbar, set alert flag",
                    "type": "number",
                    "min": 1,
                    "max": 50,
                    "sm": 12,
                    "md": 6,
                    "lg": 4
                },
                "pressureAlertMinutes": {
                    "newLine": true,
                    "label": "In period of time",
                    "help": "minutes",
                    "type": "number",
                    "min": 1,
                    "max": 1440,
                    "sm": 12,
                    "md": 6,
                    "lg": 4
                }
            }
        },
        "signalK": {
            "type": "panel",
            "label": "SignalK",
            "items": {
                "signalKEnabled": {
                    "label": "Enable SignalK server",
                    "type": "checkbox",
                    "default": false,
                    "sm": 12
                },
                "signalKPort": {
                    "label": "HTTP/WebSocket port",
                    "help": "Default SignalK port is 3000",
                    "type": "number",
                    "min": 1,
                    "max": 65535,
                    "default": 3000,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "disabled": "!data.signalKEnabled"
                },
                "signalKBidirectional": {
                    "label": "Allow SignalK clients to write to the bus",
                    "help": "Accept PUT/update deltas and inject them as PGNs (autopilot commands, simulated environment)",
                    "type": "checkbox",
                    "default": true,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "disabled": "!data.signalKEnabled"
                }
            }
        },
        "autopilot": {
            "type": "panel",
            "label": "Autopilot",
            "items": {
                "announceSrc": {
                    "label": "Source address (CAN)",
                    "help": "CAN source address used for outbound autopilot commands. Pick a value not used by any other device on the bus (typical free range: 7-23).",
                    "type": "number",
                    "min": 1,
                    "max": 251,
                    "default": 7,
                    "sm": 12,
                    "md": 6,
                    "lg": 4
                },
                "announceDevice": {
                    "newLine": true,
                    "label": "Announce as NMEA-2000 device",
                    "help": "Periodically broadcast Address Claim (PGN 60928), Product Information (PGN 126996), and a Raymarine-style Device Identification (PGN 126720). Required by some autopilots before they accept group-function commands like Pilot Wind Datum.",
                    "type": "checkbox",
                    "default": false,
                    "sm": 12
                },
                "announceUniqueNumber": {
                    "newLine": true,
                    "label": "Unique number",
                    "help": "21-bit unique ID used in the NAME field. Pick anything not colliding with other devices on the bus.",
                    "type": "number",
                    "min": 1,
                    "max": 2097151,
                    "default": 12345,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "disabled": "!data.announceDevice"
                },
                "announceManufacturerCode": {
                    "label": "Manufacturer code",
                    "help": "11-bit. 2046 = reserved/unassigned (safe for private use).",
                    "type": "number",
                    "min": 0,
                    "max": 2047,
                    "default": 2046,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "disabled": "!data.announceDevice"
                },
                "announceProductCode": {
                    "newLine": true,
                    "label": "Product code",
                    "type": "number",
                    "min": 0,
                    "max": 65535,
                    "default": 49153,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "disabled": "!data.announceDevice"
                },
                "announceModelId": {
                    "label": "Model name",
                    "type": "text",
                    "default": "ioBroker.nmea",
                    "maxLength": 32,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "disabled": "!data.announceDevice"
                },
                "announceRaymarineDeviceId": {
                    "newLine": true,
                    "label": "Raymarine device byte (PGN 126720)",
                    "help": "0 = disable. 3 = S100 controller (recommended for Raymarine bus). 16 = course computer.",
                    "type": "number",
                    "min": 0,
                    "max": 255,
                    "default": 3,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "disabled": "!data.announceDevice"
                }
            }
        },
        "simulate": {
            "type": "panel",
            "label": "Simulate",
            "items": {
                "simulationEnabled": {
                    "label": "Enabled",
                    "type": "checkbox",
                    "default": false,
                    "sm": 12
                },
                "combinedEnvironment": {
                    "label": "Combined environment",
                    "help": "Outdated",
                    "type": "checkbox",
                    "default": false,
                    "sm": 12,
                    "md": 6,
                    "lg": 3,
                    "disabled": "!data.simulationEnabled"
                },
                "simulateAddress": {
                    "label": "Source address",
                    "type": "number",
                    "min": 1,
                    "max": 252,
                    "default": 204,
                    "sm": 12,
                    "md": 6,
                    "lg": 3,
                    "disabled": "!data.simulationEnabled"
                },
                "_simulate": {
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "hidden": "!data.simulationEnabled",
                    "i18n": true,
                    "url": "custom/customComponents.js",
                    "name": "ConfigCustomNmeaSet/Components/SimulateTableComponent",
                    "bundlerType": "module",
                    "type": "custom"
                }
            }
        },
        "anchor": {
            "type": "panel",
            "label": "Anchor",
            "items": {
                "auxPosition": {
                    "newLine": true,
                    "label": "Auxiliary position state",
                    "help": "Optional foreign state that provides the boat position for the anchor alarm. Accepts 'lat;lon' / 'lat,lon' strings or JSON {lat, lon}. Leave empty to use the NMEA GNSS position",
                    "type": "objectId",
                    "default": "",
                    "sm": 12,
                    "md": 6
                },
                "chainLength": {
                    "newLine": true,
                    "label": "Chain length state",
                    "help": "Foreign state holding the currently deployed chain length in meters (e.g. from a windlass counter). Drives the anchor-drop tracker: snapshots the drop position when the chain pays out, then a 'bottom reached' position when chain length ≈ water depth",
                    "type": "objectId",
                    "default": "",
                    "sm": 12,
                    "md": 6
                },
                "notificationInstance": {
                    "newLine": true,
                    "label": "Notification instance",
                    "help": "If set, the adapter will create notifications with this instance when the anchor is dropped or lifted",
                    "type": "instance",
                    "adapters": ["telegram", "pushover"],
                    "min": 0,
                    "default": 0,
                    "sm": 12,
                    "md": 6
                }
            }
        }
    }
}
